POSTGRES_DB=prn232_lms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Connection string used by the API container when running through Docker Compose.
# Replace the password with your own value.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=prn232_lms;Username=postgres;Password=change_me

Jwt__Issuer=PRN232.LMS.API
Jwt__Audience=PRN232.LMS.Client
Jwt__Secret=change_this_local_secret_to_at_least_32_characters
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7
